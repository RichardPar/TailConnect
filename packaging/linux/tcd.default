# Options for tcd (installed as /etc/default/tcd).
# Restart after editing:  sudo systemctl restart tcd
#
# Examples:
#   -dns off           leave the host's DNS settings alone
#   -port 41642        WireGuard UDP port (default 41641)
#   -tun tc1           TUN interface name (default tc0)
#   -metrics-listen 127.0.0.1:7744   metrics at /metrics (docs/usage.md#monitoring)
TCD_ARGS=""
