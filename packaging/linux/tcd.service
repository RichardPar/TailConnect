[Unit]
Description=TailConnect client daemon
Documentation=file:///usr/local/share/doc/tailconnect/README.md
Wants=network-pre.target
After=network-pre.target NetworkManager.service systemd-resolved.service

[Service]
# Options go in /etc/default/tcd (TCD_ARGS), e.g. -dns or -port.
EnvironmentFile=-/etc/default/tcd
ExecStart=/usr/local/bin/tcd -state /var/lib/tailconnect -socket /run/tailconnect/tcd.sock $TCD_ARGS
Restart=on-failure
RestartSec=2
RuntimeDirectory=tailconnect
RuntimeDirectoryMode=0755
StateDirectory=tailconnect
StateDirectoryMode=0700
# Needs to create a TUN device and manage routes/addresses.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
DeviceAllow=/dev/net/tun rw
NoNewPrivileges=yes
ProtectSystem=strict
# MagicDNS: on hosts without systemd-resolved, tcd points resolv.conf at the
# in-tunnel resolver (and restores it on stop). With resolved it uses D-Bus.
ReadWritePaths=-/etc/resolv.conf
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
