[Unit]
Description=TailConnect coordination server
Documentation=file:///usr/local/share/doc/tailconnect/README.md
After=network-online.target
Wants=network-online.target

[Service]
# Options go in /etc/default/tc-control (TC_CONTROL_ARGS), e.g. -domain.
EnvironmentFile=-/etc/default/tc-control
ExecStart=/usr/local/bin/tc-control serve -db /var/lib/tc-control/control.db $TC_CONTROL_ARGS
Restart=on-failure
RestartSec=2
DynamicUser=yes
StateDirectory=tc-control
StateDirectoryMode=0700
# Files copied in by root (a restored backup, a database moved from another
# server) must belong to the service's dynamic user; systemd only fixes the
# directory itself. "+" runs this one command as root.
ExecStartPre=+/bin/chown -R --reference=/var/lib/private/tc-control /var/lib/private/tc-control
# Only to listen on ports below 1024 (443 and 80, for automatic HTTPS).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
