[Unit]
Description=TailConnect coordination server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/tc-control serve -db /var/lib/tc-control/control.db -listen :8080 -admin-listen 127.0.0.1:8081
Restart=on-failure
DynamicUser=yes
StateDirectory=tc-control
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
